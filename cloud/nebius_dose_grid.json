{
  "name": "zeropain-dose-grid-l40s",
  "project_id": "project-e00re3c0pr00026p9jzhq4",
  "subnet_id": "vpcsubnet-e00j50ben51r17797n",
  "image": "docker.io/pytorch/pytorch:2.4.1-cuda12.1-cudnn9-runtime",
  "platform": "gpu-l40s-a",
  "preset": "1gpu-8vcpu-32gb",
  "disk_size": "100Gi",
  "timeout_hours": 1,
  "hourly_rate": 1.55,
  "budget": 5.5,
  "preemptible": false,
  "storage": {
    "bucket": "driver-vuln-training",
    "endpoint_url": "https://storage.eu-north1.nebius.cloud:443",
    "prefix": "zeropain"
  },
  "mount_path": "/storage",
  "assets": {
    "code": "dose_grid_bundle.tar.gz"
  },
  "inject_files": {
    "run_dose_grid.sh:/workspace/run_dose_grid.sh": "run_dose_grid.sh"
  },
  "container_command": "bash",
  "command": [
    "bash",
    "/workspace/run_dose_grid.sh"
  ],
  "smoke_command": [
    "bash",
    "/workspace/run_dose_grid.sh",
    "--smoke"
  ],
  "env": {
    "HARNESS_OUTPUT_ROOT": "/storage/zeropain/dose-grid"
  },
  "smoke_gpu": false
}
